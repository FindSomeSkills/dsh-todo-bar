{
  "name": "dsh-todo-bar",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "A todo card floating over every DSH session: today's date, what is left, and the scheduled tasks the host already has queued for today.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./docs/*": "./docs/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/shot.png",
    "scripts/smoke.mjs",
    "scripts/client-smoke.mjs",
    "scripts/docs-check.mjs",
    "scripts/verify.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "todo",
    "todo-list",
    "plugin",
    "cordis",
    "dsh-plugin"
  ],
  "author": "YG",
  "homepage": "https://www.dshtoolbox.com/",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "smoke:client": "node scripts/client-smoke.mjs",
    "docs": "node scripts/docs-check.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FindSomeSkills/dsh-todo-bar"
  }
}
